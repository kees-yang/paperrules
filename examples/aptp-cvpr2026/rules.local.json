   "id": "U2", "stage": "S4", "node": "tone", "scope": "sentence", "method": "auto", "severity": "warn",
   "statement": {"en": "Do not open a sentence with “Besides,” — use “In addition,” or restructure.", "zh": "不以“Besides,”开头——用“In addition,”或重组句子。"},
   "why": {"en": "“Besides” reads as an afterthought; the next idea should follow from the one before.", "zh": "“Besides”像事后补充；下一个观点应由前一个观点引出。"},
