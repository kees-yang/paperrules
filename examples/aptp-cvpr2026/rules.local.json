   "statement": {"en": "Write “vs.” (not “v.s.”).", "zh": "写“vs.”，不写“v.s.”。"},
   "why": {"en": "One spelling of the abbreviation across the paper.", "zh": "全文同一种缩写写法。"},
   "check": {"type": "pattern", "pattern": ["\\bv\\.s\\.?"], "message": "write vs.:"},
