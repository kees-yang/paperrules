{
 "note": "Settings of the document rules. Venue-dependent rules (J1, J3, E6, B4, T5) and the opt-in style rules W20 (abstract structure) and T10 (set T10.method to your method name) are switched off in the register; enable them with \"enable\" and set the numbers here or in rules.local.json.",
 "J1": {
  "min": 150,
  "max": 250
 },
 "J3": {
  "min": 1,
  "max": 7
 },
 "E6": {
  "max_numbers": 3
 },
 "B7": {
  "required": {
   "article": [
    "author",
    "title",
    "journal",
    "year"
   ],
   "inproceedings": [
    "author",
    "title",
    "booktitle",
    "year"
   ],
   "conference": [
    "author",
    "title",
    "booktitle",
    "year"
   ],
   "book": [
    "author|editor",
    "title",
    "publisher",
    "year"
   ],
   "misc": [
    "title",
    "year"
   ],
   "default": [
    "title",
    "year"
   ]
  },
  "complete_authors": true,
  "initials": false
 },
 "W20": {
  "propose": "^We (?:therefore |thus )?propose\\b",
  "ordinals": [
   "First",
   "Second",
   "Third",
   "Fourth",
   "Fifth"
  ],
  "function": "\\b(?:provides|offers|establishes|yields)\\b"
 },
 "T10": {
  "method": ""
 }
}
